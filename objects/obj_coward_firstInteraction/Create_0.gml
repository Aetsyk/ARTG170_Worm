// Inherit the parent event
event_inherited();

dialogue.add("COWARD", "S\-S\-Stay back! I...I\'m just lost, okay? I can\'t...I can\'t...", "dizzy");
dialogue.add("YOU", "Sorry if I\'ve startled you, but I\'m looking for an exit to the surface. I\'m sure you\'re also on your way out of this place, am I wrong?");
dialogue.add("COWARD", "Oh...alright, um...I left my bunker a little bit ago, but...I can\'t leave.", "default");
dialogue.add("YOU", "I opened the bathroom door with relative ease.");
dialogue.add("COWARD", "No, I mean the tunnels. There\'s no way out of here.");

dialogue.add("YOU", "I\'m not so sure. If humanity entered the bunkers a long time ago, we must be able to leave the same way.");
dialogue.add("COWARD", "Um, I couldn\'t find any exits...All the other doors here are locked.");
dialogue.add("YOU", "Maybe there are some supplies in your bunker that could be of some help?");
dialogue.add("COWARD", "No...there\'s nothing in there...even if there was, I couldn\'t go back there anyway.");
dialogue.add("YOU", "Why not?");
dialogue.add("COWARD", "My roommate...he lost it...the mushrooms got to him...I\-I\-I had to lock him in there!", "dizzy");
dialogue.add("YOU", "Mushrooms? Calm down, friend, all the fungi down here are completely safe, edible even.");
dialogue.add("COWARD", "Did you just leave your bunker? It\'s so bad out in the halls. It might even be worse than on the surface. Mushrooms, mold, mirrors...", "dizzy");
dialogue.add("YOU", "Mirrors?");
dialogue.add("COWARD", "There\'s something inside, between the glass...W\-W\-When I looked, someone else was staring back at me, and, and, and\-", "scared");
dialogue.add("YOU", "Mirrors simply reflect the light they\'re given.");
dialogue.add("YOU", "...Actually, nevermind. Your roommate, is there a chance I could reason with him?");
dialogue.add("COWARD", "What? No...Even if you could, my bunker is really far, and I don\'t think I can find my way back now.", "dizzy");
dialogue.add("YOU", "So you\'re not from this area? Could you simply tell me where you came in from so I may look for an exit?");
dialogue.add("COWARD", "But, there\'s so much danger out there, and...", "dizzy");
dialogue.add("YOU", "If I can prove to you that there\'s nothing to worry about, will you give me a key or some other tool to help me leave? I promise I\'ll leave the path open for you.");
dialogue.add("COWARD", "...I guess?", "default");
dialogue.add("YOU", "Great! How about I start with that mirror? The pieces should be around here.");
dialogue.add("COWARD", "Oh...I scattered them around.");
dialogue.add("YOU", "Alright, then I will look for them. You stay right here.");